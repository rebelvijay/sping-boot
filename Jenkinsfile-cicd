pipeline {
    agent { label 'build' }

    environment {
        IMAGE_NAME = "vijaykumarkotikilapudi/springboot-demo"
        REPO_URL = "https://github.com/rebelvijay/sping-boot.git"
        REGISTRY = "dockerhub"
    }

    stages {

        stage('Checkout') {
            steps {
                git branch: 'master',
                    credentialsId: 'GITLABCRED',
                    url: "${REPO_URL}"
            }
        }

        stage('Build & Test') {
            steps {
                sh 'mvn clean package -DskipTests'
            }
        }

        stage('SonarQube') {
            steps {
                withSonarQubeEnv('sonarqube') {
                    sh '''
                    mvn sonar:sonar \
                    -Dsonar.projectName=springboot-demo
                    '''
                }
            }
        }

        stage('Quality Gate') {
            steps {
                timeout(time: 2, unit: 'MINUTES') {
                    script {
                        def qg = waitForQualityGate()
                        if (qg.status != 'OK') {
                            error "Quality Gate Failed: ${qg.status}"
                        }
                    }
                }
            }
        }

        stage('Build Docker Image') {
            steps {
                script {
                    env.IMAGE_TAG = "${BUILD_NUMBER}"
                    sh "docker build -t ${IMAGE_NAME}:${IMAGE_TAG} ."
                }
            }
        }

        stage('Trivy Scan') {
            steps {
                sh """
                trivy image \
                --severity HIGH,CRITICAL \
                --format json \
                -o trivy.json \
                ${IMAGE_NAME}:${IMAGE_TAG}
                """
            }
        }

        stage('Push Image') {
            steps {
                script {
                    docker.withRegistry('https://index.docker.io/v1/', REGISTRY) {
                        docker.image("${IMAGE_NAME}:${IMAGE_TAG}").push()
                    }
                }
            }
        }

        stage('Update Deployment YAML (GitOps Trigger)') {
            steps {
                sh """
                echo "Updating Kubernetes manifest..."

                sed -i 's|image:.*|image: ${IMAGE_NAME}:${IMAGE_TAG}|g' kubernetes/deployment.yml

                cat kubernetes/deployment.yml
                """
            }
        }

        stage('Commit & Push Changes') {
            steps {
                withCredentials([usernamePassword(
                    credentialsId: 'GITLABCRED',
                    usernameVariable: 'USER',
                    passwordVariable: 'PASS'
                )]) {

                    sh """
                    git config user.email "jenkins@ci.com"
                    git config user.name "jenkins"

                    git add kubernetes/deployment.yml
                    git commit -m "Deploy ${IMAGE_NAME}:${IMAGE_TAG}" || true

                    git push https://${USER}:${PASS}@gitlab.com/venkatarajukotikilapudi/springboot.git master
                    """
                }
            }
        }
    }

    post {
        success {
            echo "🚀 CI/CD SUCCESS → ${IMAGE_NAME}:${IMAGE_TAG}"
        }

        failure {
            echo "❌ CI/CD FAILED"
        }

        always {
            cleanWs()
        }
    }
}
