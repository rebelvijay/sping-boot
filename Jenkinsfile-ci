pipeline {
    agent { label 'build' }

    environment {
        JAVA_HOME = "/usr/lib/jvm/java-21-openjdk-amd64"
        PATH = "${JAVA_HOME}/bin:${PATH}"

        IMAGE_NAME = "vijaykumarkotikilapudi/springboot-demo"
        REGISTRY_CREDENTIAL = "dockerhub"
    }

    stages {

        stage('Checkout') {
            steps {
                git branch: 'master',
                    credentialsId: 'GITLABCRED',
                    url: 'https://gitlab.com/venkatarajukotikilapudi/springboot.git'
            }
        }

        stage('Build & Test') {
            steps {
                sh 'mvn clean test package -DskipTests'
            }
        }

        stage('SonarQube') {
            steps {
                withSonarQubeEnv('sonarqube') {
                    sh '''
                    mvn sonar:sonar \
                    -Dsonar.projectName=springboot-demo
                    '''
                }
            }
        }

        stage('Quality Gate') {
            steps {
                timeout(time: 2, unit: 'MINUTES') {
                    script {
                        def qg = waitForQualityGate()
                        if (qg.status != 'OK') {
                            error "Quality Gate failed: ${qg.status}"
                        }
                    }
                }
            }
        }

        stage('Build Docker Image') {
            steps {
                script {
                    env.IMAGE_TAG = "${BUILD_NUMBER}"
                    sh "docker build -t ${IMAGE_NAME}:${IMAGE_TAG} ."
                }
            }
        }

        stage('Scan Image (Trivy)') {
            steps {
                sh """
                trivy image \
                --severity HIGH,CRITICAL \
                --format json \
                -o trivy.json \
                ${IMAGE_NAME}:${IMAGE_TAG}
                """
            }
        }

        stage('Archive Report') {
            steps {
                archiveArtifacts artifacts: 'trivy.json'
            }
        }

        stage('Push Image') {
            steps {
                script {
                    docker.withRegistry('https://index.docker.io/v1/', REGISTRY_CREDENTIAL) {
                        docker.image("${IMAGE_NAME}:${IMAGE_TAG}").push()
                    }
                }
            }
        }
    }

    post {
        success {
            echo "CI SUCCESS → Image: ${IMAGE_NAME}:${IMAGE_TAG}"
        }

        failure {
            echo "CI FAILED"
        }

        always {
            cleanWs()
        }
    }
}