pipeline {
    agent { label 'build' }

    parameters {
        string(
            name: 'IMAGETAG',
            defaultValue: '',
            description: 'Docker image tag (use CI BUILD_NUMBER)'
        )
    }

    stages {

        stage('Validate Input') {
            steps {
                script {
                    if (!params.IMAGETAG?.trim()) {
                        error "IMAGETAG is required (use CI BUILD_NUMBER)"
                    }
                    echo "Deploying image tag: ${IMAGETAG}"
                }
            }
        }

        stage('Checkout Repo') {
            steps {
                git branch: 'master',
                    credentialsId: 'GITLABCRED',
                    url: 'https://gitlab.com/venkatarajukotikilapudi/springboot.git'
            }
        }

        stage('Update Kubernetes Manifest') {
            steps {
                dir('kubernetes') {
                    sh """
                    sed -i 's|image:.*|image: vijaykumarkotikilapudi/springboot-demo:${IMAGETAG}|g' deployment.yml
                    cat deployment.yml
                    """
                }
            }
        }

        stage('Commit and Push Changes') {
            steps {
                withCredentials([usernamePassword(credentialsId: 'GITLABCRED', usernameVariable: 'GIT_USER', passwordVariable: 'GIT_PASS')]) {
                    sh '''
                    git config user.email "vijaykdevops1997@gmail.com"
                    git config user.name "vijaykdevops1997"

                    git add .

                    git diff --cached --quiet || git commit -m "Deploy image tag ${IMAGETAG}"

                    git remote set-url origin https://${GIT_USER}:${GIT_PASS}@gitlab.com/venkatarajukotikilapudi/springboot.git
                    git push origin master
                    '''
                }
            }
        }
    }

    post {
        success {
            echo "SUCCESS: Deployed image tag ${IMAGETAG}"
        }

        failure {
            echo "FAILED: Deployment pipeline failed"
        }

        always {
            cleanWs()
        }
    }
}