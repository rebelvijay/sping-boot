pipeline {
    agent { label 'build' }

    parameters {
        string(
            name: 'IMAGETAG',
            defaultValue: 'latest',
            description: 'Docker image tag to deploy'
        )
    }

    stages {

        stage('Checkout Deployment Repo') {
            steps {
                git branch: 'master',
                    credentialsId: 'GITLABCRED',
                    url: 'https://gitlab.com/venkatarajukotikilapudi/springboot.git'
            }
        }

        stage('Update Kubernetes Manifest') {
            steps {
                dir('kubernetes') {

                    sh """
                    sed -i 's|image:.*|image: vijaykumarkotikilapudi/springboot-demo:${params.IMAGETAG}|g' deployment.yml
                    """

                    sh 'cat deployment.yml'
                }
            }
        }

        stage('Commit and Push Changes') {
            steps {
                sh '''
                git config user.email "vijaykdevops1997@gmail.com"
                git config user.name "vijaykdevops1997"

                git add kubernetes/deployment.yml
                git commit -m "Deploy image tag ${IMAGETAG}" || true
                git push origin master
                '''
            }
        }
    }

    post {
        success {
            echo "Deployment manifest updated successfully"
        }

        failure {
            echo "Deployment manifest update failed"
        }
    }
}