pipeline {
    agent { label 'build' }

    parameters {
        string(
            name: 'IMAGE_TAG',
            defaultValue: '',
            description: 'Docker image tag from CI (example: 35)'
        )
    }

    environment {
        IMAGE_NAME = "vijaykumarkotikilapudi/springboot-demo"
        GITOPS_REPO = "https://gitlab.com/venkatarajukotikilapudi/springboot-gitops.git"
        GITOPS_BRANCH = "master"
    }

    stages {

        stage('Validate Input') {
            steps {
                script {
                    if (!params.IMAGE_TAG?.trim()) {
                        error "❌ IMAGE_TAG is required (pass CI BUILD_NUMBER)"
                    }
                    echo "🚀 Deploying image: ${IMAGE_NAME}:${params.IMAGE_TAG}"
                }
            }
        }

        stage('Checkout GitOps Repo') {
            steps {
                git branch: "${GITOPS_BRANCH}",
                    credentialsId: 'GITLABCRED',
                    url: "${GITOPS_REPO}"
            }
        }

        stage('Update Kubernetes Manifest') {
            steps {
                sh """
                echo "Updating deployment image..."

                sed -i 's|image:.*|image: ${IMAGE_NAME}:${IMAGE_TAG}|g' kubernetes/deployment.yml

                echo "Updated deployment.yml:"
                cat kubernetes/deployment.yml
                """
            }
        }

        stage('Commit Changes') {
            steps {
                sh """
                git config user.email "jenkins@ci-cd.com"
                git config user.name "jenkins"

                git add kubernetes/deployment.yml

                git commit -m "🚀 Deploy image ${IMAGE_TAG}" || echo "No changes to commit"
                """
            }
        }

        stage('Push to GitOps Repo') {
            steps {
                withCredentials([usernamePassword(
                    credentialsId: 'GITLABCRED',
                    usernameVariable: 'USER',
                    passwordVariable: 'PASS'
                )]) {

                    sh """
                    git push https://${USER}:${PASS}@gitlab.com/venkatarajukotikilapudi/springboot-gitops.git ${GITOPS_BRANCH}
                    """
                }
            }
        }
    }

    post {
        success {
            echo "✅ CD SUCCESS: Deployed image ${IMAGE_NAME}:${IMAGE_TAG}"
        }

        failure {
            echo "❌ CD FAILED"
        }

        always {
            cleanWs()
        }
    }
}