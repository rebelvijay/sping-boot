pipeline {
    agent { label 'build' }

    parameters {
        string(
            name: 'IMAGE_TAG',
            defaultValue: '',
            description: 'Docker image tag from CI (example: 35)'
        )
    }

    environment {
        IMAGE_NAME = "vijaykumarkotikilapudi/springboot-demo"
        GIT_REPO = "https://gitlab.com/venkatarajukotikilapudi/springboot.git"
    }

    stages {

        stage('Validate Input') {
            steps {
                script {
                    if (!params.IMAGE_TAG?.trim()) {
                        error "IMAGE_TAG is required"
                    }

                    env.FULL_IMAGE = "${IMAGE_NAME}:${params.IMAGE_TAG}"
                    echo "Deploying image: ${FULL_IMAGE}"
                }
            }
        }

        stage('Checkout Repo') {
            steps {
                git branch: 'master',
                    credentialsId: 'GITLABCRED',
                    url: "${GIT_REPO}"
            }
        }

        stage('Update Kubernetes Manifest') {
            steps {
                sh """
                echo "Updating deployment image..."

                sed -i 's|image:.*|image: ${FULL_IMAGE}|g' kubernetes/deployment.yml

                echo "Updated deployment.yml:"
                cat kubernetes/deployment.yml
                """
            }
        }

        stage('Commit Changes') {
            steps {
                withCredentials([usernamePassword(
                    credentialsId: 'GITLABCRED',
                    usernameVariable: 'USER',
                    passwordVariable: 'PASS'
                )]) {

                    sh """
                    git config user.email "jenkins@ci-cd.com"
                    git config user.name "jenkins"

                    git add kubernetes/deployment.yml

                    git commit -m "Deploy ${FULL_IMAGE}" || echo "No changes to commit"
                    """
                }
            }
        }

        stage('Push Changes') {
            steps {
                withCredentials([usernamePassword(
                    credentialsId: 'GITLABCRED',
                    usernameVariable: 'USER',
                    passwordVariable: 'PASS'
                )]) {

                    sh """
                    git push https://${USER}:${PASS}@gitlab.com/venkatarajukotikilapudi/springboot.git master
                    """
                }
            }
        }
    }

    post {
        success {
            echo "✅ CD SUCCESS: ${FULL_IMAGE}"
        }

        failure {
            echo "❌ CD FAILED"
        }

        always {
            cleanWs()
        }
    }
}