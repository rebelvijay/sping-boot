pipeline {
    agent { label 'build' }

    parameters {
        string(
            name: 'IMAGETAG',
            defaultValue: 'latest',
            description: 'Docker image tag to deploy'
        )
    }

    stages {

        stage('Checkout Repo') {
            steps {
                git branch: 'master',
                    credentialsId: 'GITLABCRED',
                    url: 'https://gitlab.com/venkatarajukotikilapudi/springboot.git'
            }
        }

        stage('Verify Workspace') {
            steps {
                sh '''
                echo "Workspace structure:"
                pwd
                ls -R
                '''
            }
        }

        stage('Update Kubernetes Manifest') {
            steps {
                dir('kubernetes') {
                    sh """
                    sed -i 's|image:.*|image: vijaykumarkotikilapudi/springboot-demo:${IMAGETAG}|g' deployment.yml
                    """

                    sh "cat deployment.yml"
                }
            }
        }

        stage('Commit and Push Changes') {
            steps {

                withCredentials([usernamePassword(
                    credentialsId: 'GITLABCRED',
                    usernameVariable: 'GIT_USER',
                    passwordVariable: 'GIT_PASS'
                )]) {

                    sh """
                    git config user.email "vijaykdevops1997@gmail.com"
                    git config user.name "vijaykdevops1997"

                    git add kubernetes/deployment.yml

                    git commit -m "Deploy image tag ${IMAGETAG}" || true

                    git push https://${GIT_USER}:${GIT_PASS}@gitlab.com/venkatarajukotikilapudi/springboot.git HEAD:master
                    """
                }
            }
        }
    }

    post {
        success {
            echo "Deployment updated and pushed successfully"
        }

        failure {
            echo "Pipeline failed"
        }

        always {
            cleanWs()
        }
    }
}