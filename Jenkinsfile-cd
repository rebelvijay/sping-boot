pipeline {
    agent { label 'build' }

    parameters {
        string(
            name: 'IMAGETAG',
            defaultValue: 'latest',
            description: 'Docker image tag'
        )

        string(
            name: 'GIT_USER',
            defaultValue: 'venkatarajukotikilapudi1963',
            description: 'GitLab Username'
        )

        password(
            name: 'GIT_PASS',
            defaultValue: '',
            description: 'GitLab Personal Access Token'
        )
    }

    stages {

        stage('Checkout Repo') {
            steps {
                git branch: 'master',
                    credentialsId: 'GITLABCRED',
                    url: 'https://gitlab.com/venkatarajukotikilapudi/springboot.git'
            }
        }

        stage('Update Kubernetes Manifest') {
            steps {
                dir('kubernetes') {
                    sh """
                    sed -i 's|image:.*|image: vijaykumarkotikilapudi/springboot-demo:${IMAGETAG}|g' deployment.yml
                    cat deployment.yml
                    """
                }
            }
        }

        stage('Commit and Push Changes') {
            steps {
                sh '''
                git config user.email "vijaykdevops1997@gmail.com"
                git config user.name "vijaykdevops1997"

                git add .
                git diff --cached --quiet || git commit -m "Deploy image tag ${IMAGETAG}"

                git remote set-url origin https://${GIT_USER}:${GIT_PASS}@gitlab.com/venkatarajukotikilapudi/springboot.git

                git push origin master
                '''
            }
        }
    }

    post {
        success {
            echo "SUCCESS: Deployment manifest updated"
        }

        failure {
            echo "FAILED: Pipeline execution failed"
        }

        always {
            cleanWs()
        }
    }
}