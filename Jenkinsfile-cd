pipeline {
    agent { label 'build' }

    parameters {
        string(name: 'IMAGE_TAG', description: 'Docker image tag from CI')
    }

    environment {
        IMAGE_NAME = "vijaykumarkotikilapudi/springboot-demo"
        GITOPS_REPO = "https://gitlab.com/venkatarajukotikilapudi/springboot-gitops.git"
    }

    stages {

        stage('Validate') {
            steps {
                script {
                    if (!params.IMAGE_TAG?.trim()) {
                        error "IMAGE_TAG is required"
                    }
                }
            }
        }

        stage('Checkout GitOps Repo') {
            steps {
                git branch: 'master',
                    credentialsId: 'GITLABCRED',
                    url: "${GITOPS_REPO}"
            }
        }

        stage('Update Manifest') {
            steps {
                sh """
                sed -i 's|image:.*|image: ${IMAGE_NAME}:${IMAGE_TAG}|g' deployment.yml
                cat deployment.yml
                """
            }
        }

        stage('Commit & Push') {
            steps {
                withCredentials([usernamePassword(credentialsId: 'GITLABCRED',
                    usernameVariable: 'USER',
                    passwordVariable: 'PASS')]) {

                    sh '''
                    git config user.email "jenkins@ci.com"
                    git config user.name "jenkins"

                    git add .
                    git commit -m "Deploy ${IMAGE_TAG}" || true

                    git push https://${USER}:${PASS}@gitlab.com/venkatarajukotikilapudi/springboot-gitops.git master
                    '''
                }
            }
        }
    }

    post {
        always {
            cleanWs()
        }
    }
}